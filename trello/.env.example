# for more detail on how to getting the api key and token please check README.md
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# MCP Server Configuration
MCP_SERVER_NAME=Trello MCP Server
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=127.0.0.1

# Transport.
# true  = local stdio, used by the ChatGPT desktop app, Codex CLI and Claude app
# false = Streamable HTTP on MCP_SERVER_HOST:MCP_SERVER_PORT
USE_CLAUDE_APP=true

# Set to true for a read/fetch-only connector (recommended).
# Mutation-capable MCP tools will not be registered or advertised.
TRELLO_READ_ONLY=true

# ---------------------------------------------------------------- local mirror
# The server keeps a complete local SQLite copy of every board, list, card,
# checklist and comment so that questions spanning the whole account answer
# instantly instead of timing out. Disable only if you want live-only tools.
TRELLO_CACHE_ENABLED=true

# Show archived cards by default? Most of this account's history is archived
# (807 of 1,160 cards), so the default is true. Can also be changed at any time
# from chat -- just ask to stop showing archived cards -- and that choice is
# remembered. Archived cards stay indexed either way, so switching is instant
# and never needs a re-sync.
TRELLO_INCLUDE_ARCHIVED_DEFAULT=true

# Where the mirror lives. Defaults to %LOCALAPPDATA%\trello-mcp\trello_cache.db
# so it survives a reinstall and is never at risk of being committed.
# TRELLO_MCP_DB_PATH=C:\path\to\trello_cache.db

# Crawl on startup, then refresh every TRELLO_SYNC_INTERVAL_SECONDS.
# Set the interval to 0 to sync once at startup and never again.
TRELLO_SYNC_ON_START=true
TRELLO_SYNC_INTERVAL_SECONDS=900

# Request pacing. Measured Trello ceilings are 100 req/10s per token,
# 300/10s per key and 375/10s per member, but the edge also applies a
# reputation penalty to sustained crawling well below those numbers, so the
# defaults stay far under the allowance. The limiter throttles itself further
# whenever it sees a block, and recovers gradually.
TRELLO_REQUESTS_PER_SECOND=4
TRELLO_SYNC_CONCURRENCY=3
TRELLO_MAX_RETRIES=8

# Comment history paging. Trello caps action listings at 1000 per response.
TRELLO_COMMENT_PAGE_LIMIT=1000
TRELLO_MAX_COMMENT_PAGES=20

# Load credentials from a specific file instead of the .env beside this package.
# TRELLO_MCP_ENV_FILE=C:\path\to\secrets.env
